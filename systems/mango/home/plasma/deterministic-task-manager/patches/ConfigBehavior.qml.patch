+        const ids = []
+        for (let i = 0; i < orderedAppIdsModel.count; ++i) {
+            const id = orderedAppIdsModel.get(i).value.trim()
+            if (id.length > 0) {
+                ids.push(id)
+            }
+        }
+        root.cfg_orderedAppIds = ids
+    }
+
+    function syncOrderedAppIdsModelFromConfig() {
+        orderedAppIdsModel.clear()
+        const ids = root.cfg_orderedAppIds || []
+        for (let i = 0; i < ids.length; ++i) {
+            orderedAppIdsModel.append({
+                "value": ids[i],
+            })
+        }
+    }
+
